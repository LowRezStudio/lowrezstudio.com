---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
	title="Low-Rez Studio"
	description="Tempest is a community launcher for Paladins. Play any patch from 2016 to 2026, install mods from the Mod Library, and host or join private servers."
>
	<main class="container">
		<section>
			<hgroup>
				<h1>Low-Rez Studio</h1>
				<p>VICTORY. ALONE.</p>
			</hgroup>

			<article>
				<header>
					<hgroup>
						<h2>Tempest Launcher</h2>
						<p>Preservation & Modding Toolkit</p>
					</hgroup>
				</header>

				<p>
					Tempest is a community launcher for Paladins. You can download and play any patch
					from 2016 to 2026, install mods, and host or join private servers.
				</p>

				<div class="grid">
					<div>
						<h3>2016 - 2026</h3>
						<p><small class="secondary">Download and play any past release of Paladins.</small></p>
					</div>
					<div>
						<h3>Mod Support</h3>
						<p><small class="secondary">Install custom HUDs, sounds, textures, models and tweaks.</small></p>
					</div>
					<div>
						<h3>Private Servers</h3>
						<p><small class="secondary">Host your own games or join community-run servers.</small></p>
					</div>
				</div>

				<footer>
					<div class="grid">
						<a href="https://docs.lowrezstudio.com/tempest/introduction" role="button">
							Get Started with Tempest
						</a>
						<a href="https://mods.lowrezstudio.com" role="button" class="secondary">
							Browse Mods
						</a>
					</div>
				</footer>
			</article>
		</section>

		<section>
			<hgroup>
				<h2>Explore</h2>
				<p>Documentation, mods, and the community around Tempest.</p>
			</hgroup>

			<div class="grid">
				<article>
					<header>
						<hgroup>
							<h4>Documentation</h4>
							<p>Guides & Reference</p>
						</hgroup>
					</header>
					<p>
						Find setup guides for Tempest, modding tutorials for UDK, and details on the Marshal network protocol.
					</p>
					<footer>
						<div class="grid">
							<a href="https://docs.lowrezstudio.com" role="button" class="outline">
								Read the Docs
							</a>
							<a href="https://docs.lowrezstudio.com/blog" role="button" class="outline">
								Blog
							</a>
						</div>
					</footer>
				</article>

				<article>
					<header>
						<hgroup>
							<h4>Mod Library</h4>
							<p>Community Creations</p>
						</hgroup>
					</header>
					<p>
						Browse community-made HUDs, sounds, textures, models, and gameplay tweaks. Every mod installs in one click through Tempest.
					</p>
					<footer>
						<a href="https://mods.lowrezstudio.com" role="button" class="outline">
							Browse Mods
						</a>
					</footer>
				</article>

				<article>
					<header>
						<hgroup>
							<h4>Community</h4>
							<p>Discord & GitHub</p>
						</hgroup>
					</header>
					<p>
						Hang out with other players, share mods, talk reverse engineering, and browse our open-source code.
					</p>
					<footer>
						<div class="grid">
							<a href="https://discord.gg/yZDuxAk4d9" role="button" class="secondary outline">
								Discord
							</a>
							<a href="https://github.com/LowRezStudio" role="button" class="contrast outline">
								GitHub
							</a>
						</div>
					</footer>
				</article>
			</div>
		</section>
	</main>

	<footer class="container">
		<hr />
		<p>
			<small class="secondary">
				&copy; Low-Rez Studio
			</small>
		</p>
	</footer>
</BaseLayout>
